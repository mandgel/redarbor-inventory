{
  "realm": "inventory",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "client": {
      "inventory-api": [
        { "name": "products.read", "description": "Read products" },
        { "name": "products.create", "description": "Create products" },
        { "name": "products.update", "description": "Update products" },
        { "name": "products.delete", "description": "Delete products" },
        { "name": "categories.read", "description": "Read categories" },
        { "name": "categories.create", "description": "Create categories" },
        { "name": "categories.update", "description": "Update categories" },
        { "name": "categories.delete", "description": "Delete categories" },
        { "name": "inventory.read", "description": "Read inventory movements" },
        { "name": "inventory.create", "description": "Register inventory movements" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "inventory-api",
      "name": "Inventory API",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "inventory-api-local-secret"
    },
    {
      "clientId": "inventory-swagger",
      "name": "Inventory Swagger UI",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5000/swagger/oauth2-redirect.html",
        "https://localhost:5001/swagger/oauth2-redirect.html",
        "http://localhost:8081/swagger/oauth2-redirect.html"
      ],
      "webOrigins": [ "*" ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-inventory-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "inventory-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "permission-claim-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "inventory-api",
            "claim.name": "permission",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "inventory-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "inventory-admin@example.local",
      "firstName": "Inventory",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "AdminDev_2026!",
          "temporary": false
        }
      ],
      "clientRoles": {
        "inventory-api": [
          "products.read",
          "products.create",
          "products.update",
          "products.delete",
          "categories.read",
          "categories.create",
          "categories.update",
          "categories.delete",
          "inventory.read",
          "inventory.create"
        ]
      }
    },
    {
      "username": "inventory-reader",
      "enabled": true,
      "emailVerified": true,
      "email": "inventory-reader@example.local",
      "firstName": "Inventory",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "ReaderDev_2026!",
          "temporary": false
        }
      ],
      "clientRoles": {
        "inventory-api": [
          "products.read",
          "categories.read",
          "inventory.read"
        ]
      }
    }
  ]
}
